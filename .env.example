# Core
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Local docker-compose Postgres; swap for Supabase pooler URL in staging/prod
DATABASE_URL=postgresql://tinypay:tinypay@localhost:5432/tinypay
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=change-me-min-32-characters-long
ENCRYPTION_KEY=change-me-min-32-characters-long
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=TinyPay
WEBAUTHN_ORIGIN=http://localhost:3000

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# Stripe (P4)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Telegram
