# Core
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

# Supabase Postgres — Project Settings -> Database -> Connection string.
# DATABASE_URL: Session pooler (or Direct, for a single instance).
# DIRECT_URL: Direct connection — used only by `prisma migrate` (see
# package.json's prisma:migrate:direct script), never by the running app.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[region].pooler.supabase.com:5432/postgres?sslmode=no-verify
DIRECT_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[region].pooler.supabase.com:5432/postgres?sslmode=no-verify

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Bigisub (airtime/data)
BIGISUB_API_TOKEN=
BIGISUB_TRANSACTION_PIN=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp via Twilio (console.twilio.com -> Messaging -> Try it out -> Send a WhatsApp message)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
