// TinyPay domain model — narrowed scope: wallet, airtime, data.
// Money is always BIGINT minor units (kobo). Timestamps are UTC. Refs are ULIDs (generated in app code).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The URL comes from prisma.config.ts (DATABASE_URL) — Prisma 7 no longer
  // supports a `directUrl` field at all (schema-level or config-level).
  // When this points at Supabase's pooled connection, run migration commands
  // with `--url "$DIRECT_URL"` (a non-pooled connection, needed for schema
  // changes/advisory locks) instead — see package.json's `prisma:migrate`
  // script. The running app never touches DIRECT_URL.
}

// ---------- Identity ----------
// Supabase is used here as plain hosted Postgres — identity is this table,
// not the Supabase Auth product. The bot platforms (Telegram/WhatsApp) are
// the actual identity source; a chat id only ever resolves to a user via the
// mapping columns below, and an unmapped id is always "not enrolled".

enum UserStatus {
  active
  suspended
}

model User {
  id        String     @id @default(cuid())
  phone     String     @unique
  fullName  String?    @map("full_name")
  /// Collected once via the onboarding flow (flows/onboarding.flow.ts) right
  /// after phone is first linked — real receipts need it; fund.flow.ts's
  /// Paystack email is a synthetic placeholder, not this.
  email     String?
  status    UserStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at")

  // Chat-platform identities — a returning chat resolves back to the
  // phone-keyed identity via these, never the other way around.
  telegramUserId String? @unique @map("telegram_user_id")
  whatsappUserId String? @unique @map("whatsapp_user_id")

  wallet       Wallet?
  transactions WalletTransaction[]

  @@map("users")
}

// ---------- Wallet ----------
// Money itself lives in Paystack (funding) and is spent via Bigisub (airtime/
// data) — this is bookkeeping, not custody. Single-sided (no double-entry
// chart of accounts): there's no second party's books to keep without P2P
// transfers, so a cached balance + an append-only transaction log is enough,
// as long as every balance mutation happens in the same DB transaction as
// the WalletTransaction row that justifies it.

model Wallet {
  id          String   @id @default(cuid())
  userId      String   @unique @map("user_id")
  balanceMinor BigInt  @default(0) @map("balance_minor")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

enum WalletTransactionType {
  fund
  airtime
  data
}

enum WalletTransactionStatus {
  pending
  completed
  failed
}

enum Network {
  mtn
  glo
  airtel
  nine_mobile
}

model WalletTransaction {
  id          String                   @id @default(cuid())
  ref         String                   @unique
  walletId    String                   @map("wallet_id")
  userId      String                   @map("user_id")
  type        WalletTransactionType
  amountMinor BigInt                   @map("amount_minor")
  status      WalletTransactionStatus  @default(pending)

  // Paystack transaction reference (fund) or Bigisub order id (airtime/data).
  providerRef String? @map("provider_ref")

  // airtime/data only.
  network         Network?
  recipientPhone  String?  @map("recipient_phone")
  planCode        String?  @map("plan_code")

  failureReason String?  @map("failure_reason")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("wallet_transactions")
}

// ---------- Control ----------

model ProcessedWebhookEvent {
  eventId     String   @id @map("event_id")
  provider    String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_webhook_events")
}

/// Operator-only error log — detail that must never reach a customer (raw
/// provider errors, stack traces, internal context) but that an operator
/// needs to actually diagnose a failure, instead of grepping Render logs.
/// Written by AllExceptionsFilter (anything uncaught at the HTTP layer) and
/// by TelegramNotificationDispatcher (a purchase_failed intent's real
/// provider reason, which copyFor() deliberately keeps out of the customer
/// message — see that file).
model ServerErrorLog {
  id        String   @id @default(cuid())
  /// Where this came from: a provider name ("bigisub", "paystack"), a layer
  /// ("http"), or similar — not a strict enum, since this will grow.
  source    String
  message   String
  stack     String?
  /// Free-form structured detail (userId, ref, request path, ...).
  context   Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("server_error_logs")
}

/// Backs the conversation FSM's StateStore — no Redis in this build, so
/// session data, the optimistic-concurrency version, and the short-lived
/// per-session mutex (lockToken/lockExpiresAt) all live in one row. Sessions
/// are transient and non-authoritative for money: everything here can be
/// lost without losing a kobo.
model ConversationSession {
  key           String    @id
  data          Json?
  version       Int       @default(0)
  lockToken     String?   @map("lock_token")
  lockExpiresAt DateTime? @map("lock_expires_at")
  expiresAt     DateTime? @map("expires_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("conversation_sessions")
}
